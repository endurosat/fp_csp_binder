{
  "name": "FP CSP Binder Test Environment",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-debian-12",
  "remoteUser": "root",

  "features": {},

  "postCreateCommand": "apt-get update && apt-get install -y pkg-config libzmq3-dev libcjson-dev",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.makefile-tools",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/root/.ssh,readonly",
    "type=bind,source=${localEnv:HOME}/.gitconfig,target=/root/.gitconfig,readonly"
  ],

  "remoteEnv": {
    "GIT_SUBMODULE_STRATEGY": "none",
    "BUILD_DIR": "build",
    "DEPS_DIR": "deps"
  },

  "forwardPorts": [],

  "onCreateCommand": "chmod +x tests/scripts/*.sh"
}
