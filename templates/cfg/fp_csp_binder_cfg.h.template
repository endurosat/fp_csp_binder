#ifndef FP_CSP_BINDER_CFG_H
#define FP_CSP_BINDER_CFG_H

/* NOTE: Do NOT include RTOS or platform headers here. Those belong in the OS port header
 * (fp_csp_binder_os.h), which fp_csp_binder_port.h includes after this file. */
#include "csp_service_cfg.h"

/** @brief Spawn a UDP CSP thread to handle incoming FP requests on port @ref CSP_FP_UDP_SERVER_PORT */
#define ENABLE_UDP_THREAD

/** @brief Spawn an RDP CSP thread to handle incoming FP requests on port @ref CSP_FP_RDP_SERVER_PORT */
#define ENABLE_RDP_THREAD

/** @brief Max number of bytes reserved for CSP FP response datagrams */
#define FS_MAX_CSP_BUF_SZ_BYTES (CSP_SERVICE_CFG_BUFFER_SZ)

#ifdef ENABLE_UDP_THREAD
/** @brief Server port for UDP FP communication */
#define CSP_FP_UDP_SERVER_PORT (12)

/** @brief Max number of UDP connections allocated for FP communication */
#define CSP_FP_UDP_BACKLOG_CNT (5)
#endif

#ifdef ENABLE_RDP_THREAD
/** @brief Server port for RDP FP communication (used for ground station exchanges) */
#define CSP_FP_RDP_SERVER_PORT (13)

/** @brief Max number of RDP connections allocated for FP communication */
#define CSP_FP_RDP_BACKLOG_CNT (2)
#endif

/** @brief Number of stack bytes reserved for each server thread */
#define SERVER_THREAD_STACK_SZ (2048)

/** @brief OS thread priority level used for each server thread.
 *
 *  This value is OS-specific. Replace with the appropriate constant for your RTOS:
 *    - CMSIS RTOS2:  osPriorityNormal
 *    - FreeRTOS:     a numeric value (e.g. tskIDLE_PRIORITY + 2)
 */
#define SERVER_THREAD_PRIO (osPriorityNormal)

/** @brief Task monitor IDs for the UDP and RDP server threads.
 *  Passed to the TASK_MONITOR_* macros below. If your project has a task monitor,
 *  map these to its task ID enumeration values. */
#define TASK_ID_UDP (0)
#define TASK_ID_RDP (1)

/** @brief If task monitoring functionality is available it shall be initialized here */
#define TASK_MONITOR_INIT(task_id)

/** @brief If task monitoring functionality is available, start function for the task shall be mapped here */
#define TASK_MONITOR_START(task_id, p_thread_hnd)

/** @brief If task monitoring functionality is available, ALIVE_INDICATION function for the task shall be mapped here */
#define TASK_MONITOR_ALIVE_INDICATION(task_id)

/** @brief Logger initializer. Replace with the appropriate logger init for your project. */
#define FP_CSP_BINDER_INIT_LOGGER

/** @brief Hook called before every FP request.
 *  Replace with a subsystem-readiness check if your project requires one.
 *  @param timeout  Max wait time in milliseconds.
 *  @return FP_CMD_STATUS_NOERROR on success, FP_CMD_STATUS_TIMEOUT on timeout.
 */
#define FP_CSP_BINDER_PRE_REQUEST_HOOK(timeout)  fp_csp_binder_os_pre_request_hook(timeout)

/** @brief Attaches the CSP FP system context to a dispatch context and yields the dispatch context.
 *  The core applies it to every dispatch context before handing it to FP, so callers pass
 *  their fp_dispatch_info_t unchanged. The default uses fp_config_user_assign_sys_context() and
 *  FP_CONFIG_SYS_CTX_TYPE_CSP, declared in fp_config_user.h (see the fp configuration templates);
 *  an existing p_sys_ctx is kept. Replace this definition if your FP configuration differs.
 */
#ifndef FP_CFG_CSP_CTX
#define FP_CFG_CSP_CTX(p_disp_ctx)                                                                  \
    (((p_disp_ctx)->p_sys_ctx == NULL)                                                              \
         ? (fp_config_user_assign_sys_context((p_disp_ctx), FP_CONFIG_SYS_CTX_TYPE_CSP), (p_disp_ctx)) \
         : (p_disp_ctx))
#endif

/** @brief Critical assertion macro — halts execution on failure.
 *  Replace with your platform's critical assertion implementation.
 *  Example: #define CRIT_ASSERT(cond) assert(cond)
 */
#define CRIT_ASSERT(cond)

/** @brief Breakpoint assertion macro — triggers debugger breakpoint on failure.
 *  Replace with your platform's breakpoint assertion implementation.
 *  Example: #define BREAK_ASSERT(cond) assert(cond)
 */
#define BREAK_ASSERT(cond)

#endif /* FP_CSP_BINDER_CFG_H */
